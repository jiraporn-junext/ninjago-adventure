{
  "name": "ninjago-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Platsbasat ninjaspel i Älta, Nacka. Gör uppdrag för att hitta ninjagubbar.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
